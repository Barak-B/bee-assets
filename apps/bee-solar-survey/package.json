{
  "name": "bee-solar-survey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "B.E.E. Hive Collect — solar site survey for Wave 54 engineering intake",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "pages:dev": "wrangler pages dev --port 8788",
    "pages:deploy": "npm run build && wrangler pages deploy",
    "functions:check": "wrangler pages functions build --outdir .wrangler/functions-check",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "walkthrough": "node scripts/walkthrough.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1"
  }
}
